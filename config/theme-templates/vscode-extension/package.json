{
    "name": "theme-{theme_slug}",
    "displayName": "{theme_name} Theme",
    "description": "{theme_name} — generated by Omacosy",
    "publisher": "local",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": ["Themes"],
    "contributes": {
        "themes": [
            {
                "label": "{theme_name}",
                "uiTheme": "vs-{theme_type}",
                "path": "./themes/theme.json"
            }
        ]
    }
}
