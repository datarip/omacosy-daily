#!/usr/bin/env bash
# omacosy-karabiner-omniwm <install|remove> — the exec chords under OmniWM.
#
# OmniWM's hotkey system has no exec/shell command (verified against
# HotkeyCommand.swift: window-management cases only), so every chord
# that RUNS something — terminal, launcher, apps, theme, lock, the
# cheatsheet — dies with aerospace.toml when AeroSpace stops. Karabiner
# is already resident for Caps Lock and its complex modifications run
# shell_command, so the exec layer moves there while OmniWM is active.
#
# Injected/removed by omacosy-wm-switch on each handover — the rules
# must NOT be active under AeroSpace, whose own bindings already grab
# these chords (both firing would double every launch). Karabiner
# live-reloads karabiner.json, so injection applies instantly.
#
# Super = Caps Lock = command+control+option (the existing remap), so
# the chords arrive as ordinary modifier combos.
set -euo pipefail

KARABINER="$HOME/.config/karabiner/karabiner.json"
APPS="$HOME/.config/omacosy/apps.conf"   # resolved by install.sh
MARK="omacosy-omniwm"                     # rule-description prefix, removal key

[ -f "$KARABINER" ] || { echo "no karabiner.json" >&2; exit 1; }

TERMINAL=Ghostty BROWSER=Safari MUSIC=Spotify MESSENGER=Slack
[ -f "$APPS" ] && . "$APPS" 2>/dev/null

export KARABINER MARK TERMINAL BROWSER MUSIC MESSENGER
python3 - "$1" <<'PY'
import json, os, sys

path = os.environ["KARABINER"]
mark = os.environ["MARK"]
action = sys.argv[1]

def rule(desc, key, mods, cmd=None, to_key=None, to_mods=None):
    to = [{"shell_command": cmd}] if cmd else [{"key_code": to_key, "modifiers": to_mods or []}]
    return {
        "description": f"{mark}: {desc}",
        "manipulators": [{
            "type": "basic",
            "from": {"key_code": key, "modifiers": {"mandatory": mods}},
            "to": to,
        }],
    }

SUPER = ["command", "control", "option"]
SHIFT = SUPER + ["shift"]
home = os.environ["HOME"]
apps = {k: os.environ[k] for k in ("TERMINAL", "BROWSER", "MUSIC", "MESSENGER")}

# aerospace routes the music and messenger chords through
# omacosy-spawn-cmd, which takes the spawn lock and — under OmniWM —
# preselects the insertion side before the window appears. A bare
# `open -a` skips both, so a burst of presses lands unshaped. These
# chords are matched to what aerospace.toml does for them.
#
# The browser chord is deliberately NOT wrapped: aerospace opens it
# bare too, so the two already agree.
#
# Guarded like the files chord. omacosy-spawn-cmd lives in personal/,
# which is not on main, so a build without it keeps the bare command.
SPAWNCMD = f"{home}/.local/bin/omacosy-spawn-cmd"


def serialised(cmd):
    return f"[ -x {SPAWNCMD} ] && {SPAWNCMD} {cmd} || {cmd}"


# workspace slots: OmniWM's native switchWorkspace.N is name-global
# (always the main set), blind to which screen you are on — these route
# through omacosy-omni's cursor-display slot resolution instead. The
# native ids are Unassigned in settings.toml so nothing double-fires.
slot_rules = []
for n in range(1, 10):
    key = str(n)
    slot_rules.append(rule(f"workspace slot {n}", key, SUPER, cmd=f"{home}/.local/bin/omacosy-omni slot {n} >/dev/null 2>&1"))
    slot_rules.append(rule(f"move to slot {n}", key, SHIFT, cmd=f"{home}/.local/bin/omacosy-omni slot {n} move >/dev/null 2>&1"))

rules = slot_rules + [
    # omacosy-spawn preselects the omarchy insertion side and serializes
    # bursts — a bare `open -na` gives OmniWM's above-not-below spiral
    rule("terminal", "return_or_enter", SUPER, cmd=f"{home}/.local/bin/omacosy-spawn '{apps['TERMINAL']}'"),
    rule("browser", "return_or_enter", SHIFT, cmd=f"open -a '{apps['BROWSER']}'"),
    # trial: OmniWM's command palette on the launcher chord (Raycast
    # parked — swap the two lines to go back)
    rule("launcher", "spacebar", SUPER, cmd="/opt/homebrew/bin/omniwmctl command open-command-palette >/dev/null 2>&1"),
    rule("overview", "o", SUPER, cmd=f"{home}/.local/bin/omacosy-overview"),
    # aerospace-era throws: to the OTHER monitor, not a direction —
    # resolved per-press by omacosy-omni from the display arrangement
    rule("throw window to other monitor", "o", SHIFT, cmd=f"{home}/.local/bin/omacosy-omni throw-window >/dev/null 2>&1"),
    rule("throw workspace to other monitor", "spacebar", SHIFT, cmd=f"{home}/.local/bin/omacosy-omni throw-workspace >/dev/null 2>&1"),
    # slot-scoped cycling (1-9 stays 1-9): OmniWM's own next/prev walks
    # the guest workspaces too on a single display
    rule("next workspace", "tab", SUPER, cmd=f"{home}/.local/bin/omacosy-ws next"),
    rule("previous workspace", "tab", SHIFT, cmd=f"{home}/.local/bin/omacosy-ws prev"),
    # `open -a Finder` only ACTIVATES Finder: it raises the window that
    # already exists and never makes a second one, which is the bug
    # aerospace's binding was fixed for. omacosy-finder-window makes a new
    # window and serialises the spawn, and omacosy-spawn preselects the
    # insertion side under OmniWM just as it does under aerospace.
    #
    # Guarded, because this file is on main and that script is not: it
    # arrives with PR 9. Without it the old command still runs, so a build
    # that lacks the fix keeps the behaviour it had.
    rule("files", "f", SHIFT,
         cmd=f"[ -x {home}/.local/bin/omacosy-finder-window ] "
             f"&& {home}/.local/bin/omacosy-finder-window "
             f"|| open -a Finder"),
    rule("music", "m", SHIFT, cmd=serialised(f"open -a '{apps['MUSIC']}'")),
    rule("messenger", "g", SHIFT, cmd=serialised(f"open -a '{apps['MESSENGER']}'")),
    rule("next theme", "t", SHIFT, cmd=f"{home}/.local/bin/theme-next"),
    rule("next wallpaper", "b", SHIFT, cmd=f"{home}/.local/bin/theme-bg-next"),
    rule("lock", "l", SHIFT, cmd=f"{home}/.local/bin/omacosy-helper lock"),
    rule("cheatsheet", "k", SUPER, cmd="/usr/bin/touch /tmp/omacosy-bar-cheatsheet"),
    # OmniWM has no close-window command (HotkeyCommand.swift) — send
    # the app-level Cmd+W instead, which closes the focused window
    rule("close window", "w", SUPER, to_key="w", to_mods=["command"]),
]

with open(path) as f:
    cfg = json.load(f)

if action not in ("install", "remove", "check"):
    sys.exit("usage: omacosy-karabiner-omniwm <install|remove|check>")

changed = False
seen = stale = False
for profile in cfg.get("profiles", []):
    if not profile.get("selected", False) and len(cfg["profiles"]) > 1:
        continue
    cm = profile.setdefault("complex_modifications", {})
    existing = cm.setdefault("rules", [])
    kept = [r for r in existing if not r.get("description", "").startswith(mark)]
    if action == "check":
        # Does the keyboard carry what THIS file says? The marker alone
        # cannot answer that: a rule whose command changed keeps its
        # description, so a grep for the marker reports healthy rules while
        # an old command is still live. Compare the rules themselves.
        seen = True
        if [r for r in existing if r.get("description", "").startswith(mark)] != rules:
            stale = True
        continue
    if action == "install":
        cm["rules"] = kept + rules
        changed = True
    else:
        if len(kept) != len(existing):
            changed = True
        cm["rules"] = kept

if action == "check":
    # unseen counts as stale: nothing was compared, so nothing is proven
    ok = seen and not stale
    print("check: " + ("current" if ok else "stale or missing"))
    sys.exit(0 if ok else 1)

if changed:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=4)
    os.replace(tmp, path)
print(f"{action}: {'applied' if changed else 'no change'}")
PY
