#!/usr/bin/env bash
# theme-set <name> — switch the whole desktop theme in one move.
# Swaps ~/.config/omarchy/current/theme (the omarchy convention), then
# nudges every consumer: Korren live-reloads on its own (it watches the
# omarchy dir), the bar and borders both watch the theme and restyle
# in place — nothing here has to tell them.

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"

CUSTOM="$REPO_DIR/bin/omacosy-custom-theme"
STATE_DIR="$HOME/.local/state/omacosy"
CUSTOM_INDEX="$STATE_DIR/custom-index"

# "custom" is listed only when its wallpaper directory exists and holds an
# image. omacosy-custom-theme owns that rule.
have_custom() { [ -x "$CUSTOM" ] && "$CUSTOM" dir >/dev/null 2>&1; }
names() { for t in "$THEMES_DIR"/*/; do basename "$t"; done; have_custom && echo custom; }

case "${1:-list}" in
  list)
    names
    exit 0
    ;;
esac

NAME="$1"

# Every shipped theme is a directory under themes/. The custom theme is
# not: its colours are computed per wallpaper, so it resolves to a
# GENERATED directory whose name changes with the wallpaper. Everything
# below this point works on THEME_DIR and does not care which it got.
if [ "$NAME" = custom ] && have_custom; then
  # The custom theme REMEMBERS its wallpaper, where a shipped theme
  # restarts at its first image. A shipped theme holds 3 to 7 wallpapers
  # so restarting costs nothing; a custom folder can hold hundreds, and
  # restarting would put everything past the first few out of reach.
  IMG=""
  if [ -f "$CUSTOM_INDEX" ]; then
    IMG="$(cat "$CUSTOM_INDEX")"
    [ -f "$IMG" ] || IMG=""
  fi
  [ -n "$IMG" ] || IMG="$("$CUSTOM" list | head -1)"
  THEME_DIR="$("$CUSTOM" theme "$IMG")" || exit 1
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$IMG" > "$CUSTOM_INDEX"
elif [ -d "$THEMES_DIR/$NAME" ]; then
  THEME_DIR="$THEMES_DIR/$NAME"
else
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  names >&2
  exit 1
fi

mkdir -p "$CURRENT_DIR"
ln -sfn "$THEME_DIR" "$CURRENT_DIR/theme"

# Korren: prefer its hand-tuned built-in theme when one matches; fall
# back to live-deriving from the omarchy palette. Korren watches its
# config file, so this repaints immediately.
KORREN_CFG="$HOME/Library/Application Support/korren/config.toml"
case "$NAME" in
  tokyo-night|catppuccin|gruvbox|solarized-dark|osaka-jade|daylight) korren_theme="$NAME" ;;
  *) korren_theme="omarchy" ;;
esac
if [ -f "$KORREN_CFG" ]; then
  sed -i '' "s/^name = \".*\"/name = \"$korren_theme\"/" "$KORREN_CFG"
fi

# Wallpaper: first image in the theme's backgrounds/ dir, on every screen.
# omacosy-helper wraps NSWorkspace (System Events wallpaper scripting
# half-broke on macOS 14+: some desktops return "missing value" and
# silently keep the old picture); osascript remains as fallback.
WALL="$(ls "$THEME_DIR"/backgrounds/* 2>/dev/null | head -1)"
if [ -n "$WALL" ]; then
  # theme-bg-next cycles through the rest; a theme switch restarts the
  # cycle at the first image, so the remembered position moves with it
  mkdir -p "$HOME/.local/state/omacosy"
  ln -nsf "$WALL" "$HOME/.local/state/omacosy/background"
  if [ -x "$HOME/.local/bin/omacosy-helper" ]; then
    "$HOME/.local/bin/omacosy-helper" wallpaper "$WALL" >/dev/null 2>&1 || true
  else
    # the path is an ARGUMENT, not spliced into the script text: it is a
    # filename out of a theme pack, and a theme is third-party content.
    # A wallpaper named  x" & (do shell script "...") & ".jpg  would
    # otherwise close the AppleScript string and run.
    osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
  fi
fi


# omacosy-bar and omacosy-borders both re-read the theme on their own
# (kqueue on ~/.config/omarchy/current), so the symlink swap above IS
# the notification

# OmniWM's own focus border is OFF since 2026-09-13: it has outer gaps now,
# so omacosy-borders draws the ring under both managers and one ring is
# enough. Nothing reads the colour written below while `[borders] enabled =
# false`.
#
# The write stays anyway, because it costs one regex and it keeps
# settings.toml internally consistent — re-enable OmniWM's border and the
# colour is already the theme's rather than whatever was last mirrored. Its
# color lives there as 0-1 floats; OmniWM live-reloads, so it would recolor
# at once.
OMNIWM_SETTINGS="$HOME/.config/omniwm/settings.toml"
if [ -f "$OMNIWM_SETTINGS" ] && [ -f "$THEME_DIR/borders.sh" ]; then
  ACTIVE="$(grep -o 'ACTIVE_COLOR=0x[0-9a-fA-F]*' "$THEME_DIR/borders.sh" | head -1 | cut -d= -f2)"
  if [ -n "$ACTIVE" ]; then
    python3 - "$OMNIWM_SETTINGS" "$ACTIVE" <<'PY'
import re, sys
path, argb = sys.argv[1], sys.argv[2]
v = int(argb, 16)
r, g, b = (v >> 16 & 0xFF) / 255, (v >> 8 & 0xFF) / 255, (v & 0xFF) / 255
t = open(path).read()
sec = re.search(r'\[borders\.color\]\n(?:[a-z]+ = [0-9.]+\n)+', t)
if sec:
    new = f"[borders.color]\nalpha = 1.0\nblue = {b}\ngreen = {g}\nred = {r}\n"
    t = t[:sec.start()] + new + t[sec.end():]
    open(path, 'w').write(t)
PY
  fi
fi

# The terminal follows the desktop. The rules and the guards live in
# omacosy-term-sync, because theme-bg-next has to do exactly the same thing
# when it moves to the next wallpaper.
"$REPO_DIR/bin/omacosy-term-sync" apply "$NAME" || true

echo "theme: $NAME"
