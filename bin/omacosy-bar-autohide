#!/usr/bin/env bash
# omacosy-bar-autohide [on|off|auto|status] — whether this bar hides at rest,
# and the top gap that has to go with it. No args = status.
#
# The setting alone is not enough. A bar that stays visible occupies the top
# of the panel, so tiled windows have to start below it; a bar that hides
# gives that height back and the windows only need the ordinary margin.
# Changing one without the other either buries the bar under a window or
# wastes its height on a bar that is not there.
#
#   hiding at rest    outer.top = margin
#   visible at rest   outer.top = bar height + margin - notch inset
#
# Both numbers are asked for, not assumed: the bar's height comes from macOS
# and the inset from the display. A notched panel already excludes the camera
# strip from the usable area, so the bar sits in space no window could take
# and only the margin is left to reserve.
set -uo pipefail

CONF="$HOME/.config/omacosy/bar.conf"
AERO="$HOME/.config/aerospace/aerospace.toml"
OMNI="$HOME/.config/omniwm/settings.toml"
OMNICLI="$HOME/.local/bin/omacosy-omni"
HELPER="$HOME/.local/bin/omacosy-helper"
MARGIN=8                                   # matches the other three edges
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"

num() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
bar_height() { num "$("$HELPER" bar-height 2>/dev/null || true)" 34; }
notch_inset() { num "$("$HELPER" safe-top 2>/dev/null || true)" 0; }

# a live OmniWM answers its socket in ~3 ms; pgrep -f scanned every
# process for 31 ms per call, and a stale socket after a crash cannot
# fool a real request the way a file test could
wm_is_omniwm() { "$OMNICLI" active >/dev/null 2>&1; }

setting() {
  [ -f "$CONF" ] || { echo auto; return; }
  local v
  v=$(grep -E '^autohide *=' "$CONF" | tail -1 | cut -d= -f2 | tr -d ' ')
  case "$v" in on|off|auto) echo "$v" ;; *) echo auto ;; esac
}

# auto reads the display: a notched panel keeps the bar, a flat one hides it.
hides() {
  case "$1" in
    on) return 0 ;;
    off) return 1 ;;
    *) [ "$(notch_inset)" -eq 0 ] ;;
  esac
}

# The gap is per DISPLAY, because the bar decides per display: its own
# `autohide` is `barConf.autohide ?? !notched`, resolved against that screen's
# safeAreaInsets.top. An external monitor is never notched, so `auto` hides
# the bar there and keeps it on a notched built-in. One number for both would
# be wrong on whichever display it was not computed for.
#
# inset is the built-in's, and only the built-in can have one.
gap_for() {          # gap_for <hides:0|1> <inset>
  local hidden="$1" inset="$2" g
  [ "$hidden" -eq 0 ] && { echo "$MARGIN"; return; }
  g=$(( $(bar_height) + MARGIN - inset ))
  [ "$g" -lt "$MARGIN" ] && g=$MARGIN
  echo "$g"
}

builtin_gap() {
  local want="$1" inset; inset=$(notch_inset)
  case "$want" in
    on)  gap_for 0 "$inset" ;;
    off) gap_for 1 "$inset" ;;
    *)   if [ "$inset" -gt 0 ]; then gap_for 1 "$inset"; else gap_for 0 "$inset"; fi ;;
  esac
}

# No external display has a notch, so auto hides the bar there.
external_gap() {
  case "$1" in
    off) gap_for 1 0 ;;
    *)   gap_for 0 0 ;;
  esac
}

# what this machine's own display will use, for status
want_gap() { builtin_gap "$1"; }

# What aerospace has for THIS display. The line is normally the per-monitor
# form, `[{ monitor.'built-in' = N }, M]`, so a plain cut on the first `=`
# returns the monitor expression rather than a number. Take the built-in
# entry when it is there, and the bare value when it is not.
current_gap() {
  local line
  line=$(grep -E "^outer\\.top" "$AERO" 2>/dev/null | head -1)
  case "$line" in
    *built-in*) echo "$line" | sed -E "s|.*built-in'? *= *([0-9]+).*|\1|" ;;
    *)          echo "$line" | sed -E 's|.*= *([0-9]+).*|\1|' ;;
  esac
}

# OmniWM keeps ONE global [gaps.outer], and its other three edges are 8 like
# aerospace's, so the number is one external_gap already returns. There is
# nothing to compute twice.
#
# external_gap, not builtin_gap. One global gap serves every display, so it
# has to be the one that is never too small: the built-in's subtracts a notch
# inset an external panel does not have, and using it there would bury the bar
# under every tiled window. Equal on a notchless machine.
#
# The value is written as a FLOAT, always. OmniWM's decoder is strict and an
# integer where it wants a Double rejects the WHOLE file — and a rejected live
# reload is silent, log-only, with the in-memory state kept. So the read-back
# in `status` is the only proof the value ever landed.
#
# The substitution is anchored to the [gaps.outer] table. `bottom`, `left` and
# `right` share it, and the range guards against a second `top =` arriving in
# another table on a later OmniWM version.
omni_apply() {
  local gap="$1"
  [ -f "$OMNI" ] || return 0
  grep -qxF "top = $gap.0" "$OMNI" && return 0
  sed -i '' -E "/^\[gaps\.outer\]/,/^\[general\]/ s|^top *=.*|top = $gap.0|" "$OMNI"
}

# OmniWM's FULLSCREEN frame, which `singleWindowFit = "fill"` also uses: one
# static bool governs both Super+F and a lone window.
#
# AeroSpace expresses this per command — Super+F is `fullscreen
# --no-outer-gaps`, and the solo daemon reads bar.conf and keeps the strip
# only for `off`. OmniWM cannot, so the bool follows the setting instead:
#
#   bar VISIBLE  true   keep the gaps, so a fullscreen window cannot cover it
#   bar HIDDEN   false  edge to edge
#
# That closes docs/omniwm-port.md item 11 without giving up the stretch: the
# strip is only reserved while there is a bar in it.
#
# NOT full parity, and saying so matters. This matches aerospace for a LONE
# window, which is what solo.swift does with the same test. It does NOT match
# Super+F, which aerospace stretches ALWAYS because the binding carries
# --no-outer-gaps. So with `off` aerospace fills the screen and OmniWM keeps
# the strip. One bool cannot serve both, and the alternatives are worse: see
# docs/omniwm-port.md item 4.
omni_fullscreen_gaps() {           # omni_fullscreen_gaps <true|false>
  local want="$1"
  [ -f "$OMNI" ] || return 0
  grep -qxF "fullscreenUsesOuterGaps = $want" "$OMNI" && return 0
  sed -i '' -E "s|^fullscreenUsesOuterGaps *=.*|fullscreenUsesOuterGaps = $want|" "$OMNI"
}

omni_fs_gaps_now() {
  [ -f "$OMNI" ] || { echo -; return; }
  grep -E '^fullscreenUsesOuterGaps' "$OMNI" | tail -1 | cut -d= -f2 | tr -d ' '
}

# what is in the file
omni_file_gap() {
  [ -f "$OMNI" ] || { echo -; return; }
  sed -n -E '/^\[gaps\.outer\]/,/^\[general\]/ s|^top *= *([0-9.]+).*|\1|p' "$OMNI" | head -1
}

# what OmniWM actually resolved, which is not the same question
omni_live_gap() {
  wm_is_omniwm || { echo -; return; }
  "$OMNICLI" query displays 2>/dev/null \
    | sed -E 's|.*"outerGapTop":([0-9.]+).*|\1|' | head -1
}

apply() {
  local want="$1" gap
  mkdir -p "$(dirname "$CONF")"
  if [ -f "$CONF" ] && grep -qE '^autohide *=' "$CONF"; then
    sed -i '' -E "s|^autohide *=.*|autohide=$want|" "$CONF"
  else
    printf 'autohide=%s\n' "$want" >>"$CONF"
  fi
  # also recorded in settings.conf: install.sh applies it at every run, so
  # the choice survives an uninstall, which removes bar.conf
  local sc="$HOME/.config/omacosy/settings.conf"
  if [ -f "$sc" ]; then
    if grep -qE '^AUTOHIDE=' "$sc"; then
      sed -i '' -E "s|^AUTOHIDE=.*|AUTOHIDE=\"$want\"|" "$sc"
    else
      printf '\n# Whether the bar hides at rest: off, on or auto.\n# omacosy-bar-autohide keeps this line current.\nAUTOHIDE="%s"\n' "$want" >>"$sc"
    fi
  fi
  # Written in aerospace's per-monitor form, always. Replacing it with a bare
  # number would give an external monitor the built-in's gap, which is the
  # built-in's NOTCH allowance on a display that has none.
  local bi ex line
  bi=$(builtin_gap "$want"); ex=$(external_gap "$want")
  line="outer.top = [{ monitor.'built-in' = $bi }, $ex]"
  gap="$bi"
  if [ -f "$AERO" ] && ! grep -qxF "$line" "$AERO"; then
    sed -i '' -E "s|^outer\.top = .*|$line|" "$AERO"
    "$A" reload-config >/dev/null 2>&1
  fi
  # OmniWM's own top gap, written whether or not it is the running manager: it
  # reads the file at cold start, so the number is already right before the
  # next omacosy-wm-switch rather than after it.
  #
  # $ex, the external number. OmniWM has one gap for every display and no
  # per-monitor form in use, so it takes the value that is never too small.
  # Identical to $bi on a notchless machine.
  omni_apply "$ex"
  # and the fullscreen frame, which has to follow the same setting
  omni_fullscreen_gaps "$(hides "$want" && echo false || echo true)"
  # The native bar's auto-hide is deliberately NOT touched here.
  #
  # It looked like the missing half: `off` left this bar visible while the
  # native one still hid, so "both bars visible" seemed one `defaults write`
  # away. Clearing _HIHideMenuBar does make the native bar visible — and it
  # then covers this one completely. Measured on the same strip: with the
  # native bar hidden, 0.73% of sampled pixels are saturated, which is this
  # bar's coloured pills; with it visible, 0.00%, because what you are
  # looking at is macOS's monochrome menu bar.
  #
  # This bar's window sits at layer -20, below normal windows, so a
  # fullscreen window can cover it. The native menu bar is drawn by the
  # window server above everything. Both visible means only one is seen, and
  # it is not this one.
  #
  # So the two bars share the top edge by TAKING TURNS, which is what the
  # split is for: this bar at rest, the native one revealed by a hover on the
  # other half. Unhiding it permanently would have to come with raising this
  # bar's window level, which is a different change with its own cost.

  # the bar reads bar.conf once, at startup
  launchctl kickstart -k "gui/$(id -u)/com.omacosy.bar" >/dev/null 2>&1
  # and so does omacosy-solo, which asks the same file whether to fullscreen
  # with or without the outer gaps. Without this it keeps using the setting
  # from whenever it last started: switch the bar to always-visible and solo
  # windows go on covering it edge to edge, so the bar hides under them and
  # the change looks like it did nothing.
  launchctl kickstart -k "gui/$(id -u)/com.omacosy.solo" >/dev/null 2>&1
  printf 'omacosy: bar autohide=%s — built-in gap %s, external %s (%s at rest here)\n' \
    "$want" "$bi" "$ex" "$(hides "$want" && echo hidden || echo visible)"
  if wm_is_omniwm; then
    printf '  omniwm top gap %s, live %s; fullscreen keeps gaps: %s\n' \
      "$(omni_file_gap)" "$(omni_live_gap)" "$(omni_fs_gaps_now)"
  fi
}

case "${1:-status}" in
  on|off|auto) apply "$1" ;;
  status)
    s=$(setting)
    printf 'autohide=%s — %s at rest on this display\n' "$s" \
      "$(hides "$s" && echo hidden || echo visible)"
    printf '  native menu bar: %s\n' \
      "$([ "$(defaults read NSGlobalDomain _HIHideMenuBar 2>/dev/null)" = 1 ] && echo auto-hidden || echo visible)"
    printf '  menu bar height %s, notch inset %s, top gap wants %s, aerospace has %s\n' \
      "$(bar_height)" "$(notch_inset)" "$(want_gap "$s")" \
      "$(current_gap)"
    # an `if`, not a `&&`: this is the last command in the arm, so a missing
    # OmniWM file would otherwise make `status` itself exit non-zero
    if [ -f "$OMNI" ]; then
      printf '  omniwm top gap: file has %s, live says %s\n' \
        "$(omni_file_gap)" "$(omni_live_gap)"
      printf '  omniwm fullscreen keeps the outer gaps: %s\n' "$(omni_fs_gaps_now)"
    fi
    ;;
  # Does this bar own the top strip at rest on a display that cannot spare it?
  # omacosy-fullscreen asks, because it decides the same thing this file
  # already computes and two copies of it would drift.
  #
  # Only `off` keeps the bar on screen at rest. On a notched panel the answer
  # is still no: macOS excludes the camera strip from the usable area, so a
  # window cannot reach the bar there and there is nothing to protect.
  # ASSUMED, not measured — this machine has no notch. See
  # notes/notched/TEST-REQUEST.md.
  # The top gap, for omacosy-fullscreen, which has two of them to write.
  #   rest        bar height + margin - inset, what a tiled window leaves
  #   fullscreen  bar height - inset, flush with the bar and no margin
  # A fullscreen window takes everything the bar does not, so the margin that
  # separates tiles from the bar is a strip of desktop with nothing in it —
  # and omacosy-borders drew its ring top edge into it.
  top-gap)
    case "${3:-builtin}" in
      external) i=0 ;;
      *) i=$(notch_inset) ;;
    esac
    case "${2:-rest}" in
      fullscreen) g=$(( $(bar_height) - i )); [ "$g" -lt 0 ] && g=0; echo "$g" ;;
      *) case "${3:-builtin}" in
           external) external_gap "$(setting)" ;;
           *) builtin_gap "$(setting)" ;;
         esac ;;
    esac
    ;;
  keeps-strip)
    s=$(setting)
    case "${2:-builtin}" in
      # no external display has a notch, so the inset is 0 by definition and
      # `auto` hides the bar there
      external) [ "$s" = off ] && echo yes || echo no ;;
      *) { [ "$s" = off ] && [ "$(notch_inset)" -eq 0 ]; } && echo yes || echo no ;;
    esac
    ;;
  *) echo "usage: omacosy-bar-autohide [on|off|auto|status|keeps-strip]" >&2; exit 1 ;;
esac
