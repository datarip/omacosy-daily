#!/usr/bin/env bash
# theme-next — cycle to the next theme (bound to ctrl+alt+shift+space).

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"

themes=()
for t in "$THEMES_DIR"/*/; do themes+=("$(basename "$t")"); done

# The custom theme comes LAST, after every shipped one, and only when
# there is something to show: its wallpaper directory has to exist and
# hold at least one image. omacosy-custom-theme owns that rule and exits
# 1 silently when it is not met, so a machine that never opted in cycles
# the four shipped themes exactly as before.
CUSTOM="$REPO_DIR/bin/omacosy-custom-theme"
if [ -x "$CUSTOM" ] && "$CUSTOM" dir >/dev/null 2>&1; then themes+=("custom"); fi

# A derived theme's directory is named after a hash, so basename() alone
# would answer with the hash instead of "custom". The same command owns
# that translation; for every shipped theme it returns what basename()
# returned before.
current=""
[ -x "$CUSTOM" ] && current="$("$CUSTOM" current 2>/dev/null || true)"
if [ -z "$current" ]; then
  current="$(basename "$(readlink "$HOME/.config/omarchy/current/theme" 2>/dev/null || echo "${themes[0]}")")"
fi

next="${themes[0]}"
for i in "${!themes[@]}"; do
  if [ "${themes[$i]}" = "$current" ]; then
    next="${themes[$(( (i + 1) % ${#themes[@]} ))]}"
    break
  fi
done

exec "$REPO_DIR/bin/theme-set" "$next"
